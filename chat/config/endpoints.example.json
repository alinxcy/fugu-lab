      "rates_per_model": {
        "fugu-ultra": {
          "input_per_mtok": 5, "output_per_mtok": 30, "cached_input_per_mtok": 0.5,
          "input_per_mtok_over_272k": 10, "output_per_mtok_over_272k": 45, "cached_input_per_mtok_over_272k": 1.0
        },
        "fugu-cyber": {
          "input_per_mtok": 6, "output_per_mtok": 36, "cached_input_per_mtok": 0.6,
          "input_per_mtok_over_272k": 12, "output_per_mtok_over_272k": 54, "cached_input_per_mtok_over_272k": 1.2
        },
        "fugu": {
          "input_per_mtok": null, "output_per_mtok": null, "cached_input_per_mtok": null,
          "_note": "base fugu のレートは未取得。要確認。"
        }
      }
    }
  }
}
